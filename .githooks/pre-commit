#!/usr/bin/env bash
# pre-commit: 스테이징에 스키마 마이그레이션 변경이 있으면 물리 ERD 를 재생성해 이 커밋에 포함한다.
#
# 활성화(클론당 1회):  git config core.hooksPath .githooks
# 의존: PostgreSQL 18 (initdb·pg_ctl·psql, PATH 에 있어야 함).
# 재생성 실패(도구 없음 등) 시 커밋을 막지 않고 경고만 한다 — 이 훅은 편의이고 강제성이 없다.
# 집행은 CI 가 한다(ALPHA-783): schema-validate 가 PR 에서 재생성해 커밋본과 대조하고 어긋나면 빨간불.
set -uo pipefail

# 마이그레이션이 스테이징됐을 때만 동작한다(일반 커밋은 즉시 통과 — 매 커밋마다 DB 를 띄우지 않음).
changed="$(git diff --cached --name-only)" || exit 0
case "$changed" in
  *src/libs/schema/migrations-cloud/*|*src/libs/schema/migrations-onprem/*) ;;
  *) exit 0 ;;
esac

root="$(git rev-parse --show-toplevel)"
echo "[pre-commit] 스키마 마이그레이션 변경 감지 → 물리 ERD 재생성..."
if bash "$root/src/libs/schema/scripts/generate-erd.sh"; then
  git add "$root/src/libs/schema/generated/physical-erd.dbml" \
          "$root/src/libs/schema/generated/physical-erd-onprem.dbml"
  echo "[pre-commit] generated/*.dbml 갱신·스테이징 완료."
else
  echo "[pre-commit] 경고: ERD 재생성 실패(PostgreSQL 18 필요). ERD 가 낡은 채 커밋됩니다." >&2
  echo "[pre-commit]        pg18 을 깔 필요는 없다 — docker 로 재생성해 다시 커밋하세요:" >&2
  echo "[pre-commit]        chmod -R a+w src/libs/schema/generated && docker run --rm -v \"\$PWD:/repo\" -w /repo --user postgres postgres:18 bash src/libs/schema/scripts/generate-erd.sh" >&2
  echo "[pre-commit]        안 고쳐도 CI(schema-validate)가 같은 대조로 잡는다." >&2
fi
exit 0
