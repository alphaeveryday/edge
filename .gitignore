# ──────────────────────────────────────────────
# OS / Editor
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
*.iml
.vscode/
!.vscode/extensions.json

# ──────────────────────────────────────────────
# 빌드 산출물 (공통)
# ──────────────────────────────────────────────
out/
dist/
build/
*.log

# GitHub Pages (MkDocs) 빌드 산출물 (sync/generate 스크립트가 생성)
pages/site/
pages/docs/reference/
pages/docs/evolution.md

# ──────────────────────────────────────────────
# JVM / Gradle
# ──────────────────────────────────────────────
.gradle/
**/build/
*.class
.kotlin/

# ──────────────────────────────────────────────
# Node / pnpm
# ──────────────────────────────────────────────
node_modules/
.pnpm-store/
*.tsbuildinfo
.turbo/
.next/
.cache/
.vite/

# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# ──────────────────────────────────────────────
# 환경 변수 / 시크릿
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

# Local planning scratch files. Durable project docs belong under docs/ or tracked .dev scripts.
.dev/*-plan.md

# 세션 임시 산출물. 에이전트·수동 작업이 저장소 루트에 흘리는 것들 - 커밋 대상이 아니고
# 지우지 않으면 다음 세션의 `git status` 를 덮어 실제 변경을 가린다.
.tmp/
.tmp_*
test_out.txt

# drawio 자동 백업(`.$<이름>.drawio.bkp`). 편집 중 생기고 원본과 함께 갱신된다 -
# 저장소에 두면 diff 가 두 배가 되고 어느 쪽이 정본인지 흐려진다.
.$*.bkp

# 로컬 레이크 캐시. 실 데이터는 S3 에 있고 이건 재현 가능한 사본이다.
.lake/

.tmp/
*.dtmp
.$*
