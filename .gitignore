# ──────────────────────────────────────────────
# OS / Editor
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
*.iml
.vscode/
!.vscode/extensions.json

# ──────────────────────────────────────────────
# 빌드 산출물 (공통)
# ──────────────────────────────────────────────
out/
dist/
build/
*.log

# GitHub Pages (MkDocs) 빌드 산출물 (sync/generate 스크립트가 생성)
pages/site/
pages/docs/reference/
pages/docs/evolution.md
# 브랜드 로고·파비콘 사본 — 캐노니컬은 src/libs/ui-kit/src/assets (sync 가 복사)
pages/docs/assets/images/edge-logo-*.svg
pages/docs/assets/images/edge-favicon.svg

# ──────────────────────────────────────────────
# JVM / Gradle
# ──────────────────────────────────────────────
.gradle/
**/build/
*.class
.kotlin/

# ──────────────────────────────────────────────
# Node / pnpm
# ──────────────────────────────────────────────
node_modules/
.pnpm-store/
*.tsbuildinfo
.turbo/
.next/
.cache/
.vite/

# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# ──────────────────────────────────────────────
# 환경 변수 / 시크릿
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

# Local scratch. 저장소는 .dev/ 안의 어떤 파일도 추적하지 않는다 — 공유할 문서는 docs/,
# 공유할 스크립트는 scripts/ 로 간다. 추적 파일이 없어야 워크트리마다 .dev 를 통째로
# 심링크로 붙일 수 있다(디렉터리를 심링크로 바꾸면 git 이 추적 파일을 typechange 로 본다).
/.dev

# 세션 임시 산출물. 에이전트·수동 작업이 저장소 루트에 흘리는 것들 - 커밋 대상이 아니고
# 지우지 않으면 다음 세션의 `git status` 를 덮어 실제 변경을 가린다.
.tmp/
.tmp_*
test_out.txt

# drawio 자동 백업(`.$<이름>.drawio.bkp`). 편집 중 생기고 원본과 함께 갱신된다 -
# 저장소에 두면 diff 가 두 배가 되고 어느 쪽이 정본인지 흐려진다.
.$*.bkp

# 로컬 레이크 캐시. 실 데이터는 S3 에 있고 이건 재현 가능한 사본이다.
.lake/

# 캐시 실험 산출물(k6 요약·메트릭 덤프). 머신·실행마다 달라지는 측정치라 저장소에 두지
# 않는다 - 채택 결과만 코드·문서로 간다.
# 디렉터리 자체가 아니라 내용물을 무시한다 - 디렉터리를 통째로 제외하면 git 이 안으로
# 내려가지 않아 .gitkeep 예외가 먹지 않는다.
tests/loadtest/publication/results/*
!tests/loadtest/publication/results/.gitkeep

.tmp/
*.dtmp
.$*

.tmp/
