{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "오늘의 급등주 해석 공개 데이터 (truth/data/movers/latest.json, 미국 truth/data/movers/us/latest.json)",
  "description": "설계: docs/design/truth-movers.md §4",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "generatedAt", "items"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generatedAt": {"type": "string", "minLength": 20},
    "pricedAt": {"type": ["string", "null"], "description": "가격(Yahoo, 국내 약 20분 늦음)의 마지막 체결 시각(그 시장 현지 시각). 가격 갱신(prices)이 매분 고친다"},
    "items": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "market", "logo", "price", "prevClose", "changePct", "tradeValue", "series", "tag",
                   "confidence", "event", "claim", "finding", "reasons", "sources", "impact", "judgedAt"],
      "properties": {
        "code": {"type": "string", "pattern": "^([0-9A-Z]{6}|[A-Z][A-Z0-9]{0,5}(\\.[A-Z])?)$", "description": "국내 종목코드 6자리 · 미국 티커"},
        "name": {"type": "string", "minLength": 1, "maxLength": 40},
        "market": {"enum": ["KOSPI", "KOSDAQ", "KONEX", "NASDAQ", "NYSE", "AMEX"]},
        "logo": {"type": ["string", "null"], "pattern": "^data/logos/([0-9A-Z]{6}|us/[A-Z][A-Z0-9]{0,5}(\\.[A-Z])?)\\.(png|jpg|ico|webp)$"},
        "price": {"type": "number", "exclusiveMinimum": 0, "description": "국내 원 · 미국 달러"},
        "prevClose": {"type": "number", "exclusiveMinimum": 0},
        "changePct": {"type": "number"},
        "tradeValue": {"type": "number", "minimum": 0, "description": "누적 거래대금: 국내 억원 · 미국 백만 달러"},
        "series": {"type": "array", "maxItems": 90, "items": {
          "type": "array", "prefixItems": [{"type": "string", "pattern": "^\\d{2}:\\d{2}$"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
        "tag": {"enum": ["promising", "false", "pending"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "event": {
          "type": "object", "additionalProperties": false, "required": ["title", "kind", "at"],
          "properties": {
            "title": {"type": "string", "minLength": 2, "maxLength": 60},
            "kind": {"enum": ["disclosure", "earnings", "contract", "policy", "news", "rumor", "unknown"]},
            "at": {"type": ["string", "null"]}
          }
        },
        "claim": {"type": "string", "maxLength": 300},
        "finding": {"type": "string", "maxLength": 400},
        "reasons": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 2, "maxLength": 160}},
        "sources": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["title", "publisher", "url", "kind", "publishedAt"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "publisher": {"type": "string", "minLength": 1},
            "url": {"type": "string", "pattern": "^https?://"},
            "kind": {"enum": ["official", "disclosure", "news", "web", "video"]},
            "publishedAt": {"type": ["string", "null"]}
          }
        }},
        "impact": {"type": "number", "minimum": 0},
        "judgedAt": {"type": ["string", "null"]},
        "marks": {"type": "array", "maxItems": 12, "description": "오늘 판정 이력(그래프의 점). price 는 판정 때 본 가격, null 이면 그 시각 시세로 찍는다",
                  "items": {"type": "object", "additionalProperties": false, "required": ["at", "tag", "price"], "properties": {
                    "at": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
                    "tag": {"enum": ["promising", "false", "pending"]},
                    "price": {"type": ["number", "null"], "exclusiveMinimum": 0}}}}
      }
    }
  }
}
