  <diagram name="P0–P9 인과귀속" id="1">
    <mxGraphModel dx="1334" dy="920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" value="causal/run.py::explain — P0–P9 단계별 폐쇄" vertex="1">
          <mxGeometry height="40" width="1200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p2s" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" value="어느 단계도 건너뛰지 않는다 — 후보가 산술로 전멸하거나 가설이 0개여도 P8 은 돈다(처분 폐쇄). 수치는 전부 원장에서 오고 모델이 타이핑할 자리가 없다." vertex="1">
          <mxGeometry height="30" width="1500" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" value="코드 소유 (결정적)" vertex="1">
          <mxGeometry height="30" width="240" x="40" y="105" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" value="LLM 세션" vertex="1">
          <mxGeometry height="30" width="200" x="300" y="105" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" value="게이트 · 분기" vertex="1">
          <mxGeometry height="30" width="200" x="520" y="105" as="geometry" />
        </mxCell>
        <mxCell id="q0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P0 · 질문 고정 (p0_question.ask)&#xa;반사실을 문장으로 정의 · residual(잔차) 산출 · Šidák 스캔 보정 p_scan&#xa;답의 형태를 먼저 선언한다 — 무료" vertex="1">
          <mxGeometry height="90" width="760" x="440" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="산술 게이트 (engine.arithmetic_gate) — LLM 전에 돈다&#xa;무게 없는 원인은 여기서 죽는다: share·prior 로 잔차를 못 채우면 killed&#xa;가장 싼 게이트가 가장 세다" vertex="1">
          <mxGeometry height="90" width="760" x="440" y="300" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P1 · 지문 채취 (p1_fingerprint.take)&#xa;모양 · 폭 · 시점 · 사전표류 · 크기. 가설 이전, LLM 이전&#xa;후보가 전멸해도 뜬다 — 못 잰 축이 P8 의 미결 항목이 된다" vertex="1">
          <mxGeometry height="90" width="760" x="440" y="430" as="geometry" />
        </mxCell>
        <mxCell id="ne" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="no_explanandum?  (잔차가 이 셀 자신의 귀무분포 안)" vertex="1">
          <mxGeometry height="80" width="760" x="440" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ne_y" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="alive = []&#xa;LLM 을 부르지 않는다 — 부르면 반드시 무언가를 찾아내고&#xa;그 서사는 검출 하한 아래라 반증 불가능하다" vertex="1">
          <mxGeometry height="80" width="420" x="1300" y="560" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P2 · 다중 가설 (p2_hypotheses.propose · n=3, 세션 독립)&#xa;어휘 무제한 — 골격도 후보 목록도 주지 않는다. 어휘를 닫으면 새 메커니즘을 영영 못 본다&#xa;가설마다 role: 배경조건 · 촉발원 · 전달경로 · 증폭 · 종료 (probable_cause 는 복수)" vertex="1">
          <mxGeometry height="100" width="760" x="440" y="680" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P3 · 그래프 + 공통원인 완비 (p3_graph.build)&#xa;그린 변수의 공통원인을 전수 선언(Hernán 조건)&#xa;assignment=chosen(배당·자사주·가이던스)이면 컴파일러가 U ↔ (T,Y) 를 심고 모델이 지울 수 없다&#xa;구조 위반(시간 역행 등)은 violations 로 적재" vertex="1">
          <mxGeometry height="110" width="760" x="440" y="820" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P4 · 식별 3값 (p4_identify.identify_all)&#xa;identified / identified_under(가정) / not_identified&#xa;빈 조정집합 ≠ 뒷문 없음. not_identified 는 실패가 아니라 정상 종료&#xa;지지집합(support)은 타입 과거 최대에서 — 유계 가정 없이는 Manski 경계가 무한하다" vertex="1">
          <mxGeometry height="110" width="760" x="440" y="970" as="geometry" />
        </mxCell>
        <mxCell id="q5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P5 · 판별 설계 (p5_discriminate.design) ★&#xa;선언된 U 마다 소거 검정을 설계. 못 적으면 미소거로 확정&#xa;미소거 U 가 하나라도 있으면 &quot;원인으로 확인됐습니다&quot; 가 구조적으로 나갈 수 없다" vertex="1">
          <mxGeometry height="100" width="760" x="440" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="gv" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="graph.violations 있나?" vertex="1">
          <mxGeometry height="80" width="760" x="440" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="gv_y" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="estimate_skipped&#xa;구조 검사는 무료, 검정은 가장 비싸다 —&#xa;시간 역행 그래프로 세션을 열면 그 추정치가 처분까지 올라간다" vertex="1">
          <mxGeometry height="80" width="420" x="1300" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="est" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="검정 실행 (_estimate) — 가장 비싸다.  간선 하나마다 표본을 만든다&#xa;statistical 간선만 대상 · ADMG(방향 + 잠재 양방향)로 브리프를 만들어 U 를 보게 한다&#xa;placebo 로 귀무분포를 붙이고, 값은 원장 호출 기록에서만 읽는다 — 모델이 타이핑한 p 는 게이트 G4 가 거부" vertex="1">
          <mxGeometry height="110" width="760" x="440" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="sbx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="CAUSAL_SANDBOX_ENABLED&#xa;true → LLM 이 쓴 코드를 제한 exec&#xa;   (as_of 바인딩 · 창 절단 · __ 금지 · import 허용목록 · 타임아웃)&#xa;false → 축약 경로(고정 추정량). 같은 산출 계약(_as_proof)&#xa;ops 킬스위치 — 프롬프트 주입 표면이다" vertex="1">
          <mxGeometry height="130" width="360" x="40" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="bud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="예산 (chain.budget) — 회계 폐쇄&#xa;사슬을 세우고 statistical 칸을 검정 결과로 채운다&#xa;귀속의 합이 잔차를 넘으면(over_budget) 그래프가 틀렸다 — 카이제곱보다 싸고 날카롭다&#xa;관계 폐쇄: share 는 coincident 쌍에서만 정의된다(배타·포섭·직렬을 평탄 합산 금지)" vertex="1">
          <mxGeometry height="110" width="760" x="440" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="q6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P6 · 민감도 (p6_sensitivity.evaluate) — E-value&#xa;식별이 안 될 때 강도를 재는 유일한 축: 미관측 교란이 처치·결과와 얼마나 강해야 뒤집히나&#xa;결과 산포는 대조 표본(n ≥ 30)에서 — 귀무 산포로 대신하면 E-value 가 부풀어 오른다" vertex="1">
          <mxGeometry height="100" width="760" x="440" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="q7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P7 · 음성대조 · 혼재 스크린 (p7_negative + _screen)&#xa;영향 없어야 할 자리가 조용한가 · 같은 날 다른 공시로 처치군이 오염됐나&#xa;처치군을 특정하지 못하면 &quot;검사했다&quot; 고 말하지 않는다" vertex="1">
          <mxGeometry height="100" width="760" x="440" y="1860" as="geometry" />
        </mxCell>
        <mxCell id="q8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P8 · 처분 원장 (p8_findings.dispose → narrate) — 조건 없이 돈다&#xa;검토한 전건을 기여 / 비기여 / 미결 중 하나로 판정. 침묵 금지&#xa;screened 전량을 넘긴다 — 죽은 후보만 넘기면 산술 통과 후 가설로 못 선 후보가 원장에서 사라진다&#xa;커버리지 폐쇄: 메커니즘 8영역(정보·공통충격·수급·미시구조·피드백·제도·측정·무사건) 개방 여부 기재&#xa;narrate 가 주장 상한을 어긴 문장을 PipelineError 로 막는다" vertex="1">
          <mxGeometry height="140" width="760" x="440" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="q9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="P9 · 누적 (p9_registry.record)&#xa;CAUSAL_REGISTRY_ROOT 있을 때만 — 단일 사례 귀속은 반복으로만 검정력을 얻는다&#xa;비면 소환 기록 없음을 로그로 남긴다(조용히 사라지지 않는다)" vertex="1">
          <mxGeometry height="90" width="760" x="440" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=12;verticalAlign=middle;" value="Explanation.raw&#xa;verdict · 본문 · raw.causal 감사블록&#xa;(처분 전건 · 미소거 U · 식별 상태와 가정 · 판별 검정 · 민감도 · 음성대조 · 원장 전량 · 에이전트가 쓴 코드)" vertex="1">
          <mxGeometry height="90" width="760" x="440" y="2350" as="geometry" />
        </mxCell>
        <mxCell id="sql" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;verticalAlign=middle;" value="자유 질의 표면 (sql_surface)&#xa;P2 · P3 · P5 만 쓴다. 시점 클램프는 뷰 안&#xa;없으면 세 단계가 조회 없이 돌고&#xa;판별 검정이 전부 실행 불가 →&#xa;주장 상한이 자동으로 내려간다" vertex="1">
          <mxGeometry height="130" width="360" x="40" y="820" as="geometry" />
