        <mxCell id="L2" value="가설 세션 × 3&#xa;병렬 · 독립 · 서로 못 봄&#xa;sql() 자유 질의 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
