        <mxCell id="firm" value="기업 고유사건&#10;(source_event 30,785 · τ 초단위)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
