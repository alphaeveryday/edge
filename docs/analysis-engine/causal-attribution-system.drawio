        <mxCell id="s3" value="S3  s3://edge-dev-pipeline-lake&#xa;canonical / draft / feature / raw" style="swimlane;startSize=50;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
