<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="1. 실행 흐름">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="ETF 하루 설명 — 위에서 아래로.  앞 4단은 &lt;b&gt;결정론 산술&lt;/b&gt;(검산 가능), 마지막 1단만 &lt;b&gt;모델&lt;/b&gt;." style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="설명 예산 상한 = 층 3 + 종목 5 = &lt;b&gt;서사 8개&lt;/b&gt;.  실측 675셀 중앙 1개(87%가 시장만으로 종료)." style="text;html=1;fontSize=13;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="q" value="질문&#xa;&quot;오늘 KODEX 반도체 왜 빠졌어?&quot;&#xa;(etf_id=091160, day=2026-07-29)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tot" value="설명 대상 = ETF 자신의 일간 수익률&#xa;&lt;b&gt;−8.66%&lt;/b&gt;  (yfinance 091160.KS, 관측 가능)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="q" target="tot"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== 결정론 스윔레인 ===== -->
        <mxCell id="det" value="결정론 산술  —  모델 없음.  합이 정확히 맞고 누구나 검산한다." style="swimlane;startSize=34;html=1;fillColor=#f5faff;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="1120" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="L0" value="0.  밤사이 미국장&#xa;&lt;i&gt;layers.overnight(day)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="det">
          <mxGeometry x="30" y="60" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L0d" value="한국 09:00 개장 &lt;b&gt;전에 이미 확정&lt;/b&gt; → 갭의 정당한&#xa;원인 후보. 국내 장중 사건보다 시간적으로 앞선다.&#xa;&#xa;07-29:  iShares반도체 −4.80%&#xa;              필라델피아반도체 −4.49% · VIX" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="40" y="105" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="1.  시장 층 (항상 먼저)&#xa;&lt;i&gt;KODEX 200 · β 60일 추정 · 당일 제외&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="det">
          <mxGeometry x="30" y="220" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="L1d" value="−6.55% × β1.14[1.04,1.23] = &lt;b&gt;−7.45%p&lt;/b&gt;&#xa;&#xa;왜 β 를 추정하나: 차분(rᵢ−r_sec)은 β=1 을 강제한다.&#xa;실측 β_시장 1.4~1.8 — 배정할 양의 40~80%를 과소&#xa;배정해 차액을 조용히 고유로 민다." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="40" y="265" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="L1s" value="1b.  그 코스피는 왜 움직였나&#xa;&lt;i&gt;layers.market_source(day)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1" vertex="1" parent="det">
          <mxGeometry x="400" y="220" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="L1sd" value="코스피 −6.55% 중 밤사이 미국이 설명하는 몫&#xa;= &lt;b&gt;[+0.05, +0.67]%p&lt;/b&gt;  (β 구간 · 점 아님)&#xa;&#xa;→ &lt;b&gt;미국으로 설명 안 된다. 국내 요인이다.&lt;/b&gt;&#xa;   (07-30 은 [−4.89,−0.34] → 미국이 설명)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="410" y="265" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="2.  섹터 층 ≤2  —  탐욕 선택&#xa;&lt;i&gt;후보 = 보유 스냅샷 있는 KR ETF 32종&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="det">
          <mxGeometry x="30" y="400" width="710" height="230" as="geometry" />
        </mxCell>
        <mxCell id="L2a" value="후보 자격 = &lt;b&gt;구성 비중 겹침&lt;/b&gt;  Σ min(wᵢᵃ, wᵢᵇ)&#xa;&#xa;  ≥0.30  동어반복 → 제외&#xa;     실측: KODEX반도체를 TIGER반도체(0.93)로 설명했다&#xa;  &lt;0.05  근거 없음 → 제외&#xa;     실측: 2차전지를 게임산업(0.00)이 β0.71[0.40,1.02] 로&#xa;     &quot;설명&quot;했다 — 산술은 맞고 아무도 안 믿는다&#xa;&#xa;&lt;b&gt;적합도가 아니라 겹침이 자격을 정한다&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="40" y="440" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="L2b" value="선택 규칙&#xa;  · 시장에 &lt;b&gt;직교화&lt;/b&gt;(Gram-Schmidt) → 중복 없음&#xa;  · |남은 몫| 을 가장 줄이는 것 1개씩&#xa;  · β 신뢰구간이 0 을 품으면 &lt;b&gt;쓰지 않는다&lt;/b&gt;&#xa;  · 커버 50% 도달 또는 층 3개에서 정지&#xa;&#xa;07-29: 시장만으로 86% → &lt;b&gt;섹터 없이 종료&lt;/b&gt;&#xa;07-30: + TIGER AI반도체핵심공정(겹침 15%)&#xa;            −7.00% × β0.40 = −2.78%p" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="400" y="440" width="330" height="180" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="3.  남은 몫(고유) = 하루 − Σ 층 기여&#xa;&lt;b&gt;−1.21%p&lt;/b&gt; · 설명 86% · ρ=+0.275" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="det">
          <mxGeometry x="30" y="660" width="710" height="180" as="geometry" />
        </mxCell>
        <mxCell id="L3a" value="&lt;b&gt;'고유'라 부르지 않는다&lt;/b&gt; — 이름 없는 잔여다.&#xa;잔차 평균 횡단면 상관 ρ 를 매 셀 보고한다:&#xa;  ρ≈0  →  고유라 부를 자격&#xa;  ρ&gt;0  →  이름 없는 공통요인이 남아 있다&#xa;&#xa;실측 675셀 ρ 중앙 &lt;b&gt;+0.17&lt;/b&gt; · 55% 가 0.15 이상&#xa;→ 아직 자격 없음. 섹터 커버리지가 부족하다." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="40" y="700" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="L3b" value="설명률 = 1 − |남은 것| / |하루|&#xa;&#xa;|Σ기여|/|하루| 로 재면 안 된다 — 층이 반대로&#xa;과설명해도 비율이 커져 &quot;덮었다&quot;가 된다.&#xa;실측 208% 가 나왔다(하루 −1.13, 시장 +2.35).&#xa;&#xa;&lt;b&gt;음수가 나올 수 있고 그게 정직하다&lt;/b&gt;&#xa;675셀 중 65셀이 음수 = 층이 반대로 밀었다" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="400" y="700" width="330" height="135" as="geometry" />
        </mxCell>

        <mxCell id="L4" value="4.  남은 몫을 청구하는 종목 ≤5   —   순위 = &lt;b&gt;비중 × 고유&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="det">
          <mxGeometry x="30" y="870" width="1060" height="160" as="geometry" />
        </mxCell>
        <mxCell id="L4a" value="큰 종목의 작은 움직임과 작은 종목의 큰 움직임을 같은 자로 잰다.  eᵢ = rᵢ − Σβᵢₖ·x̃ₖ (선택된 층에만 회귀)&#xa;&#xa;   삼성전자   비중 23.5%  수익 −5.37%  중 고유 &lt;b&gt;+2.56%&lt;/b&gt;  →  +0.60%p&#xa;   SK하이닉스 비중 39.5%  수익 −10.11% 중 고유 −0.81%  →  −0.32%p&#xa;   DB하이텍   비중  1.9%  수익 −12.41% 중 고유 −6.03%  →  −0.12%p          … 순합과 &lt;b&gt;밀고 당긴 총량&lt;/b&gt;을 같이 낸다(부호 상쇄를 숨기지 않는다)&#xa;&#xa;   ⚠ 거래량 0 인 날은 제외 — 정지 종가의 수익률 0 은 거짓.  단 &lt;b&gt;진짜 보합은 정보다&lt;/b&gt;(시장이 −7% 미는데 안 빠졌으면 그게 힘). 무변동 776일 중 정지는 55일(7%)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="det">
          <mxGeometry x="40" y="905" width="1040" height="120" as="geometry" />
        </mxCell>

        <mxCell id="eL01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="det" source="L0" target="L1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="det" source="L1" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL1s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="det" source="L1" target="L1s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="det" source="L2" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="det" source="L3" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== LLM 스윔레인 ===== -->
        <mxCell id="llm" value="모델 개입  —  선택된 5종목의 고유분에만.  셀 좌표는 코드가 잡고 모델은 못 바꾼다(표본 선택 금지)." style="swimlane;startSize=34;html=1;fillColor=#fdf5ff;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1320" width="1120" height="700" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="셀 = (종목, 날짜)&#xa;attribute.run_cell()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="llm">
          <mxGeometry x="30" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="① 시간 분해 (항등식)&#xa;5분봉 → 갭 · 창@사건시각 ±15분 · 잔여&#xa;&lt;b&gt;합 = 하루&lt;/b&gt;. τ 는 초 단위 사이드카" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="270" y="50" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="② 가설 에이전트 (LLM #1)&#xa;도구 FSM 을 돌며 접지 → 튜플 3개&#xa;&lt;b&gt;닫힌 어휘 밖 = 날조 폐기&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="560" y="50" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="C4" value="③ 패널 검정 (순수 코드)&#xa;타입 수준 역사 · 게이트 A–E&#xa;&lt;b&gt;검정자는 표본을 못 고른다&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="850" y="50" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="C5" value="④ 격자 스크린 (전수·결정론)&#xa;사건타입 × 노출 전 격자를 LLM 과 무관하게 훑는다 — &lt;b&gt;커버리지 이중화&lt;/b&gt;.&#xa;탐색이지 확증이 아니다(p 양측·방향 사후). 실측: LLM 이 5회 놓친&#xa;PRODUCT.LAUNCH × 거래량/변화 p₂=0.000 n=435 를 격자가 1위로 찾았다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="270" y="160" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="⑤ 기억 (P9 레지스트리)&#xa;&lt;b&gt;회상이 기록보다 먼저&lt;/b&gt; — 오늘 결과가&#xa;자기 이력에 들어가면 첫 발견이&#xa;재발견으로 보인다. 당일 미만만 회상." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="850" y="160" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="C7" value="⑥ SEM 크기 (성립 엣지에만)&#xa;식별집합 = CI(τ·Δx) ∩ (0, 고유인 총합]&#xa;공집합이면 &lt;b&gt;과대식별 모순&lt;/b&gt; 표기 —&#xa;모형이 자기모순을 자백한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="30" y="290" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="C8" value="⑦ 서사 계약 (7가드 · statics/narrate.py)&#xa;   1 접지 없는 사건 id 인용 → 즉시 예외 (날조 차단)&#xa;   2 &lt;b&gt;아닌 것 먼저&lt;/b&gt; (NTSB) — 기각된 후보를 앞에&#xa;   3 미설명이 최대면 그것이 선두 문장&#xa;   4 판정불가는 &quot;모른다&quot;로만 — 기각으로 위장 금지&#xa;   5 반사실 없으면 positivity 침묵 명시&#xa;   6 표와 산문이 &lt;b&gt;같은 객체&lt;/b&gt;를 가리켜야 함&#xa;   7 게이트 미계산은 그 어법으로만" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="llm">
          <mxGeometry x="320" y="290" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="C9" value="산출 (투자자 어법)&#xa;&#xa;■ 밤사이 미국 → 코스피(+미국 몫 구간)&#xa;■ 섹터(겹침% 표기)&#xa;■ 층 합계 · 남은 몫 · &lt;b&gt;설명 %&lt;/b&gt;&#xa;■ 종목별 비중 × 고유 → 기여&#xa;■ 종목마다: 창별 몫 · 성립 엣지 · 모른다&#xa;&#xa;⚠ ρ · 추적오차 · 정지종목 · 후보제외&#xa;   전부 표면에 — 조용히 빼지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0" vertex="1" parent="llm">
          <mxGeometry x="740" y="290" width="350" height="200" as="geometry" />
        </mxCell>

        <mxCell id="C10" value="포기 목록 (정직) — 구조적 한계이지 데이터 부족이 아니다&#xa;  · 오늘 충격의 절대크기 g : 고정효과와 상충 · 이분그래프 89% 단절&#xa;  · 되먹임 : DAG 원리상 불가&#xa;  · 극단 결과 직접 검정 : 기저율&#xa;  · &lt;b&gt;대형주 점귀속 : 요인 오염&lt;/b&gt; (SK하이닉스는 KODEX반도체의 39.9%) → 거절&#xa;  · 전이 몫 배정 : 소스–타깃 5분봉 정렬 필요 → 엣지 검정까지만 (assignable=False)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1" vertex="1" parent="llm">
          <mxGeometry x="30" y="500" width="1060" height="120" as="geometry" />
        </mxCell>

        <mxCell id="eC12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="llm" source="C1" target="C2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="llm" source="C2" target="C3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="llm" source="C3" target="C4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="llm" source="C4" target="C5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC56" value="회상 먼저" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0;exitY=0.2;entryX=1;entryY=0.8;" edge="1" parent="llm" source="C6" target="C3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="llm" source="C5" target="C7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="llm" source="C7" target="C8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="llm" source="C8" target="C9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eDL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;exitX=0.2;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="L4" target="C1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 우측 원칙 -->
        <mxCell id="P" value="세 가지를 섞지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="1230" y="220" width="600" height="330" as="geometry" />
        </mxCell>
        <mxCell id="Pd" value="&lt;b&gt;크기는 산술&lt;/b&gt;  —  시간 항등식과 층 항등식.&#xa;   성과기여 분석이지 인과추론이 아니다. 합이 정확히 맞고&#xa;   종속변수와 &lt;b&gt;상한&lt;/b&gt;을 만든다.&#xa;&#xa;&lt;b&gt;인과는 역사&lt;/b&gt;  —  타입 수준 패널.&#xa;   오늘 하루로는 무엇도 증명 못 한다. 같은 사건타입이&#xa;   과거에 어떻게 움직였나만 묻는다.&#xa;&#xa;&lt;b&gt;조건은 계수&lt;/b&gt;  —  조절자.&#xa;   취약성은 표본을 쪼개지 않고(검정력이 죽는다)&#xa;   교호 대비로 보고한다. 오늘 충족 여부가 적용을 정한다.&#xa;&#xa;&lt;b&gt;게이트는 크기를 만들지 않는다&lt;/b&gt; · 부재 = 판정불가+사유&#xa;재실행 결정론 (SEED=0) · 모델은 쉬운 것만" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1250" y="255" width="570" height="290" as="geometry" />
        </mxCell>

        <mxCell id="M" value="실측 (675셀 = ETF 32 × 거래일 22, 2026-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="1230" y="590" width="600" height="330" as="geometry" />
        </mxCell>
        <mxCell id="Md" value="지표             중앙    25%    75%     최소     최대&#xa;설명률          0.67   0.38   0.84   −19.89   1.00&#xa;층 수            1      1      1       1       3&#xa;잔차 ρ          0.17   0.10   0.28   −0.04   0.57&#xa;&#xa;설명률 ≥50%      470/675  (70%)&#xa;설명률 &lt;0         65/675  (층이 반대로 밀었다 — 정직한 실패)&#xa;시장만으로 종료   585/675  (87%)&#xa;층 3개 소진        14/675&#xa;ρ ≥0.15 경고     165/298  (공통요인 잔존 — 섹터 부족)&#xa;&#xa;서사 1개당 설명량  중앙 &lt;b&gt;12.2%p/서사&lt;/b&gt;&#xa;셀당 서사 총수    중앙 1개 · 최대 8개 (설계 상한 8)" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1250" y="625" width="570" height="290" as="geometry" />
        </mxCell>

        <mxCell id="V" value="판정 — 무엇이 좋아졌고 무엇이 남았나" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="1230" y="960" width="600" height="320" as="geometry" />
        </mxCell>
        <mxCell id="Vd" value="좋아진 것&#xa;  · 항등식이 정확히 맞는다 (이전 산출은 −5.56 vs −9.61)&#xa;  · 동어반복·우연적합 섹터가 차단된다&#xa;  · &quot;설명 못 했다&quot;를 음수 설명률로 말한다&#xa;  · 미국→코스피 연결로 &quot;국내 요인&quot; 판정이 나온다&#xa;&#xa;남은 것 (정직)&#xa;  · &lt;b&gt;ρ 중앙 0.17&lt;/b&gt; — 아직 '고유'라 부를 자격 없음&#xa;  · 87%가 시장 1층으로 끝난다 = 섹터 어휘가 얇다&#xa;     (ETF 34종 중 28종이 반도체 — 수집 편중)&#xa;  · 화학·금융·바이오·자동차 섹터 ETF 없음&#xa;  · 추적오차: 구성종목 커버 82~94%" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1250" y="995" width="570" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. 데이터 원천과 뷰">
