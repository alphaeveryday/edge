    </mxGraphModel>
  </diagram>

  <diagram name="5. 의도한 문장 → 증명된 문장" id="p5">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t5" value="가설이 의도한 문장  →  실제로 증명된 문장 (한미 07-30 · 원문 대조)" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ch1" value="env.intent — 판정 전에 못 박은 것" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="panel — 코드가 잰 것" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ch3" value="판정문 — 실제로 증명된 문장 (범위 축소 포함)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1160" y="80" width="700" height="26" as="geometry" />
        </mxCell>

        <mxCell id="r1i" value="C1 · 자사주 매입&#10;&#10;&quot;자사주 매입 발표가 물량을 받아&#10; 테마 폭락일에 보합을 방어했다.&#10; 창@09:00 이 +4.71%p 로 하루 최대&#10; 양(+)의 몫이고, 자사주매입 타입의&#10; 과거 패널 방향이 양이면 성립.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r1p" value="n=26 · 효과 미계산&#10;오늘 노출 미계산&#10;코드 의견: 판정불가&#10;   (확증 표본 n=26 &lt; 30)&#10;&#10;자동 프로브도 동일" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r1v" value="✓ 성립 (중) — 코드 의견을 뒤집음&#10;&#10;증명된 것: 접지 실재 + 창@09:00 이 하루 유일한 양(+) 구간(갭·잔여2 는 둘 다 음) + 가설 부호와 실현 부호 일치, 3중 정합.&#10;반사실: 창 제거 시 -4.71%&#10;&#10;증명 안 된 것 (판정문이 스스로 적음):&#10;· &quot;과거 패널 방향이 양&quot; — intent 의 두 번째 조건은 n=26&lt;30 으로 미검증&#10;· 창 +4.71%p 전부를 C1 에 못 준다 — C2 와 공유, 단독 귀속은 상한&#10;· 고유 +10.11%p 중 46.6% 만 설명 — 나머지 +5.40%p 는 미설명 몫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="700" height="170" as="geometry" />
        </mxCell>

        <mxCell id="r2i" value="B1 · 미 반도체 → 테마 직격&#10;&#10;&quot;미 반도체 급락이 K반도체 테마를&#10; 직격해 섹터 몫 -7.85%p 를 만들었다.&#10; 방향·시간 정합이면 성립.&#10; 단 β2.05 는 외삽 의심 — 인공물인지&#10; 정상 변동인지 갈라서 판정하라.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r2p" value="n=0 · 효과 미계산&#10;코드 의견: 판정불가 —&#10;  노출 (지수잔차,변화) 는&#10;  아직 못 잰다&#10;  재는 것: [(가격잔차,누적)&#10;   (가격잔차,변동성)&#10;   (거래량,변화) (거래량,수준)]&#10;&#10;프로브 2개도 n=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="320" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r2v" value="◐ 갈라 판정 — 이 체계가 처음 만든 판정 형태&#10;&#10;성립(구조): 미 반도체 -5.3% → 테마⊥ -3.83%, 부호·시간(개장 전 확정 → 갭 반영) 정합. 07-31 경계 판정의 &quot;정상장 유효&quot; 구간.&#10;&#10;기각(크기): 개장 전 확정 정보면 갭에 실려야 하는데 갭 -2.39%p 는 시장층 -2.26%p 로 거의 소진 → 섹터 증분 갭 ≈ -0.13%p.&#10;배정된 -7.85%p 는 β2.05 외삽 인공물이고 고유 +10.11 과 대칭 상쇄되는 회계 쌍. 순 전이 ≈ 0.&#10;&#10;※ 코드의 EdgeVerdict 는 3값 리터럴 — 이 판정을 표현할 수 없다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="320" width="700" height="180" as="geometry" />
        </mxCell>

        <mxCell id="r3i" value="A1 · 위험회피&#10;&#10;&quot;밤사이 위험회피(VIX +13.45%)가&#10; 코스피 -2.02% 를 눌렀다 —&#10; 미국 몫 [-4.89,-0.34]%p 가 하락을&#10; 포함하고 거시 발화면 성립.&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r3p" value="n=0 · 효과 미계산&#10;코드 의견: 판정불가 —&#10;  계열 '거시' 의 혁신값을&#10;  아직 못 잰다&#10;&#10;프로브 2개도 n=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="530" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r3v" value="✓ 성립 (중상) — 단, 근거가 패널이 아니다&#10;&#10;증명된 것: 구간 포함 [-4.89,-0.34] ∋ -2.02% + 거시가 오늘 유일 발화(z=+2.9) + 시간 정합(갭 -2.39 ≈ 시장층 -2.26, 차 -0.13%p) + 같은 날 삼성 셀 독립 재현.&#10;&#10;증명 안 된 것: 효과 점추정 없음 — 패널 n=0. 판정문이 명시: &quot;이 성립은 패널 효과추정이 아니라 층분해·구간포함·발화 z 에 근거한다.&quot;&#10;범위: &quot;왜 시장이 올랐/내렸나&quot; 에만 성립. &quot;왜 이 종목이 시장보다 더/덜 갔나&quot; 에는 무력." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="530" width="700" height="160" as="geometry" />
        </mxCell>

        <mxCell id="pat" value="세 사례가 같은 모양을 보인다 — 의도는 넓게, 증명은 좁게&#10;&#10;패널이 성립을 만든 간선은 9개 중 0개다. 세 성립 모두 근거가 패널 밖(접지·시간 항등식·구간 포함·부호·재현)에 있다.&#10;이건 강점이자 약점이다. 강점: 패널이 죽어도 결론이 난다 — 판정불가 0/72. 약점: 통계적 확증이 아니라 논증이라 재실행 재현성이 보장되지 않는다.&#10;&#10;그래서 판정문이 스스로 범위를 좁힌다: &quot;확증은 아니다&quot; · &quot;단독 귀속 상한&quot; · &quot;46.6% 만 설명, 나머지는 미설명&quot; · &quot;패널 효과추정이 아니다&quot; · &quot;이 질문에는 무력&quot;.&#10;이 축소 문장들이 result.md 로 접히면서 상당수 사라진다 — 미설명 몫을 숨기지 않는 것이 서술 계약인데, 접는 과정에서 계약이 깨진다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=16;fontSize=13;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1820" height="180" as="geometry" />
        </mxCell>

        <mxCell id="cnt" value="8셀 72간선 누적 — 성립 19 · 기각 53 · 판정불가 0&#10;코드 워크플로우 대조 (traces/*.jsonl 실측): 27판정 · 성립 3 · 불성립 20 · 판정불가 4(15%) · 기각 사유 전부 빈칸" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=16;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1820" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
