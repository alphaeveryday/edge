        <mxCell id="L3" value="v2 — 판별력 (증명 6: 감별진단 · 반증 · 민감도)    ▶ 기획" style="swimlane;startSize=34;html=1;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;verticalAlign=top;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
