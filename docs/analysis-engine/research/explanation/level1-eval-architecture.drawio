  <diagram name="level1-eval-architecture">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
