# VM-1 의 /etc/edge/batch.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
#
# 한 파일을 두 곳이 읽는다: docker --env-file(컨테이너 env)과 호스트 스크립트(lib/batch.sh · lib/edge_cron.py).
# 둘 다 KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# ── 호스트 스크립트가 읽는 값 ──
# 파이프라인 이미지(레지스트리 주소와 태그까지)
EDGE_PIPELINE_IMAGE=
# 선택. 스텝 컨테이너 메모리 상한(기본 2g)
EDGE_STEP_MEMORY=
# DAG 가 terraform 에서 받던 명령 인자(infra/terraform/modules/data-pipeline/variables.tf 의 krx_etf_deadline_sec,
# minute_services.tf 의 minute_universe_uri). 유니버스 URI 는 VM-2 분 워커가 읽는 것과 같은 값이어야 한다.
EDGE_KRX_ETF_DEADLINE_SEC=
EDGE_MINUTE_UNIVERSE_URI=
# 통보 메일 — 앱 메일 계정(호스트·계정은 infra/terraform/envs/dev/main.tf 의 SPRING_MAIL_HOST·SPRING_MAIL_USERNAME 과 같다)
EDGE_MAIL_HOST=
EDGE_MAIL_USER=
EDGE_DEV_APP_API_MAIL_PASSWORD=
EDGE_ALERT_TO=
# 감시가 크기를 재는 레이크 디렉터리(MinIO 데이터 디렉터리의 호스트 경로. cron 사용자가 읽을 수 있어야 한다)
EDGE_LAKE_DATA_DIR=
# 감시가 켜고 끄는 인스턴스
EDGE_VM2_OCID=
EDGE_VM3_OCID=

# ── 컨테이너(data_pipeline.run)가 읽는 값 ──
# 레이크(MinIO). 코드는 boto3 기본 클라이언트를 쓰므로 접속 주소·키를 boto3 표준 env 로 준다.
DATA_PIPELINE_STORAGE__BACKEND=
DATA_PIPELINE_STORAGE__BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_REGION_NAME=
# PostgreSQL(VM-1). 컨테이너에서 보이는 주소를 쓴다(localhost 는 컨테이너 자신이다). TLS 를 안 쓰면 SSLMODE 를 맞춘다.
DATA_PIPELINE_DB__HOST=
DATA_PIPELINE_DB__PORT=
DATA_PIPELINE_DB__NAME=
DATA_PIPELINE_DB__USER=
DATA_PIPELINE_DB__PASSWORD=
DATA_PIPELINE_DB__SSLMODE=
DATA_PIPELINE_CALL_BUDGET__ENABLED=
# 분석 스냅샷 정리(vm1/snapshot_retention.sh)만 읽는 값. tool_runs 를 지울 수 있는 계정의 libpq 접속값과,
# PostgreSQL 데이터 디렉터리가 있는 디스크의 호스트 경로(같은 파일시스템이면 상위 디렉터리여도 된다 — 여유 공간만 읽는다).
# PGSSLMODE 는 선택이다.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
DB_DISK_PATH=
# 휴장일(쉼표로 구분한 YYYY-MM-DD). 원장이 아니라 수집·정제의 거래일 판정이 읽는다 — 빼면 평일 휴장일을 거래일로 본다.
OPS_KR_HOLIDAYS=
# KIS
# 토큰 파일 캐시 디렉터리(호스트 경로). 스텝 컨테이너에 같은 경로로 붙는다 — 미리 만들고 uid 1001 이 쓸 수 있게 한다.
# 빼면 스텝마다 토큰을 새로 받는다(KIS 는 잦은 재발급을 막는다).
KIS_TOKEN_CACHE_DIR=
DATA_PIPELINE_KIS_PRICE__SOURCE__APP_KEY=
DATA_PIPELINE_KIS_PRICE__SOURCE__APP_SECRET=
DATA_PIPELINE_KIS_NAV__SOURCE__APP_KEY=
DATA_PIPELINE_KIS_NAV__SOURCE__APP_SECRET=
DATA_PIPELINE_KIS_INVESTOR__SOURCE__APP_KEY=
DATA_PIPELINE_KIS_INVESTOR__SOURCE__APP_SECRET=
# KRX
DATA_PIPELINE_KRX_ETF__SOURCE__MBR_ID=
DATA_PIPELINE_KRX_ETF__SOURCE__PW=
# DART
DATA_PIPELINE_DART_FINANCIAL__SOURCE__API_KEY=
DATA_PIPELINE_DART_DISCLOSURE__SOURCE__API_KEY=
DATA_PIPELINE_DART_DISCLOSURE__WATERMARK_WINDOW=
# 매크로(ECOS·KOSIS·EIA·FRED)
DATA_PIPELINE_SOURCE_OBSERVATIONS__MACRO__ECOS_API_KEY=
DATA_PIPELINE_SOURCE_OBSERVATIONS__MACRO__KOSIS_API_KEY=
DATA_PIPELINE_SOURCE_OBSERVATIONS__MACRO__EIA_API_KEY=
DATA_PIPELINE_SOURCE_OBSERVATIONS__MACRO__FRED_API_KEY=
