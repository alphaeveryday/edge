# VM-1 의 /etc/edge/batch.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
# KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# 호스트 스크립트(lib/batch.sh · vm1/watchdog.py)만 읽는다. 컨테이너에 넘기지 않는다 — 비밀값을 두지 않는다.

# 파이프라인 이미지(레지스트리 주소와 태그까지)
EDGE_PIPELINE_IMAGE=
# 선택. 스텝 컨테이너 메모리 상한(기본 2g)
EDGE_STEP_MEMORY=
# 선택. 스텝 하나의 시간 상한(초, 기본 5400). 넘으면 컨테이너를 지우고 레인을 멈춘 뒤 알린다.
# 스텝 하나만 바꾸려면 EDGE_TIMEOUT_SEC_<레인>_<스텝> 을 쓴다(대문자, - 는 _ 로. 예: EDGE_TIMEOUT_SEC_ETF_DAILY_COLLECT_PRICE).
EDGE_STEP_TIMEOUT_SEC=
# DAG 가 terraform 에서 받던 명령 인자(infra/terraform/modules/data-pipeline/variables.tf 의 krx_etf_deadline_sec,
# minute_services.tf 의 minute_universe_uri). 유니버스 URI 는 VM-2 분 워커가 읽는 것과 같은 값이어야 한다.
EDGE_KRX_ETF_DEADLINE_SEC=
EDGE_MINUTE_UNIVERSE_URI=
# 감시가 크기를 재는 레이크 디렉터리(MinIO 데이터 디렉터리의 호스트 경로. cron 사용자가 읽을 수 있어야 한다)
EDGE_LAKE_DATA_DIR=
# OCI CLI 실행 파일의 절대 경로(예: 공식 설치 스크립트면 홈의 bin/oci). 실행할 수 없으면 감시가 메일을 보낸다
OCI_CLI=
# 감시가 켜고 끄는 인스턴스
EDGE_VM2_OCID=
EDGE_VM3_OCID=
