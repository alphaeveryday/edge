# VM-1 의 /etc/edge/retention.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
# KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# 분석 스냅샷 정리 스텝(vm1/snapshot_retention.sh)에만 넘긴다. 다른 스텝은 이 값을 받지 않는다.

# tool_runs 를 지울 수 있는 계정의 libpq 접속값. PGSSLMODE 는 선택이다.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
# PostgreSQL 데이터 디렉터리가 있는 디스크의 호스트 경로. 컨테이너에 읽기 전용으로 붙여 여유 공간만 읽는다
# (같은 파일시스템이면 상위 디렉터리여도 된다). 없으면 정리 레인이 시작하지 않는다.
DB_DISK_PATH=
