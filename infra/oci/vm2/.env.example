# VM-2 compose 가 읽는 값 — 이름만 둔다. 실제 값은 호스트의 .env 에 넣고 커밋하지 않는다.
# 쓰지 않는 줄은 지운다 — 빈 값도 컨테이너에 빈 문자열로 전달된다.

# ── 이미지 ──
DATA_PIPELINE_IMAGE=
ANALYSIS_IMAGE=

# ── compose 치환 ──
# 1분 가격 세션의 source_group (지금 dev 는 kis)
MINUTE_SOURCE_GROUP=
# universe.json — planner·worker·consumer 가 같은 객체를 본다
MINUTE_UNIVERSE_URI=

# ── 큐 모드 ──
DATA_PIPELINE_MINUTE_QUEUE_TRANSPORT=db
# 세션 종료 게이트 — db 모드에서는 큐 URL 이 아니라 destination 이름
MINUTE_SESSION_GATE_QUEUES=price-analysis-realtime,news-extraction-realtime
MINUTE_SESSION_DRAIN_TIMEOUT_SEC=

# ── data-pipeline 공통 ──
DATA_PIPELINE_DB__HOST=
DATA_PIPELINE_DB__PORT=
DATA_PIPELINE_DB__NAME=
DATA_PIPELINE_DB__USER=
DATA_PIPELINE_DB__PASSWORD=
DATA_PIPELINE_STORAGE__BACKEND=
DATA_PIPELINE_STORAGE__BUCKET=
DATA_PIPELINE_CALL_BUDGET__ENABLED=
DATA_PIPELINE_MINUTE_ARTIFACT_FORMAT=
OPS_KR_HOLIDAYS=

# ── 세션에 얹는 레인 (비우면 그 레인은 계획하지 않는다) ──
MINUTE_SESSION_NEWS_SOURCE_GROUP=
MINUTE_SESSION_DISCLOSURE_SOURCE_GROUP=
MINUTE_SESSION_INAV_SOURCE_GROUP=
MINUTE_SESSION_SECTOR_INDEX_SOURCE_GROUP=

# ── 1분 워커 ──
DATA_PIPELINE_MINUTE_PRICE_WORKER__SOURCE=
DATA_PIPELINE_MINUTE_PRICE_WORKER__TRIGGER_SCHEMA_VERSION=
DATA_PIPELINE_MINUTE_PRICE_WORKER__APP_KEY=
DATA_PIPELINE_MINUTE_PRICE_WORKER__APP_SECRET=
DATA_PIPELINE_KIS_NAV__SOURCE__APP_KEY=
DATA_PIPELINE_KIS_NAV__SOURCE__APP_SECRET=
DATA_PIPELINE_DART_DISCLOSURE__SOURCE__API_KEY=
# KIS 토큰 파일 캐시 — 호스트 디렉터리(절대 경로, uid 1001 쓰기 가능). compose 가 KIS 를
# 부르는 서비스(price-worker·inav-worker·sector-index-worker)에 같은 경로로 붙인다
KIS_TOKEN_CACHE_DIR=

# ── 가격 변동 판정 ──
DATA_PIPELINE_MINUTE_PRICE_CONSUMER__DETECTION_POLICY_VERSION=

# ── 장중 설명 분석 ──
# 동시에 도는 분석 수 (VM 에선 2~4)
ANALYSIS_SLOTS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
TINYFISH_API_KEY=
OBSERVATION_BUCKET=
# 분석 DB 접속은 아직 AWS 방식이다(Secrets Manager + RDS CA) — OCI 대체는 별도 작업
AWS_REGION=
RDS_CA_PATH=

# ── 객체 저장소 (MinIO 등 S3 호환) ──
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=
