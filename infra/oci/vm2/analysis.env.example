# VM-2 의 analysis 컨테이너만 읽는 값 — 이름만 둔다. 호스트에서 .env.analysis 로 복사해 채우고
# 커밋하지 않는다(.gitignore 의 .env.* 가 막는다). 쓰지 않는 줄은 지운다 — 빈 값도 전달된다.
# data-pipeline 의 값(DB 소유자 계정·KIS·DART 키)은 여기 넣지 않는다.

# ── 큐 모드 ── (ANALYSIS_QUEUE_TRANSPORT=db 는 compose 가 넣는다)
# 동시에 도는 분석 수 (VM 에선 2~4)
ANALYSIS_SLOTS=

# ── 모델 ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
TINYFISH_API_KEY=

# ── 분석 DB (env 접속 — EDGE_ANALYSIS_DB_HOST 가 있으면 Secrets Manager·RDS 를 부르지 않는다) ──
EDGE_ANALYSIS_DB_HOST=
EDGE_ANALYSIS_DB_PORT=
EDGE_ANALYSIS_DB_NAME=
EDGE_ANALYSIS_DB_SSLMODE=
EDGE_ANALYSIS_DB_WRITER_USER=
EDGE_ANALYSIS_DB_WRITER_PASSWORD=
EDGE_ANALYSIS_DB_READER_USER=
EDGE_ANALYSIS_DB_READER_PASSWORD=
# 서버 인증서를 검증하는 sslmode 에서 쓰는 CA 묶음 경로(컨테이너 안)
RDS_CA_PATH=

# ── 관측 저장 (MinIO 등 S3 호환) ──
OBSERVATION_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# boto3 세션 생성에 필요하다(지금 코드가 요구한다)
AWS_REGION=
