# VM-3 compose 가 읽는 값 — 이름만 둔다. 실제 값은 호스트의 .env 에 넣고 커밋하지 않는다.
# 쓰지 않는 줄은 지운다 — 빈 값도 컨테이너에 빈 문자열로 전달된다.

# ── 이미지 ──
DATA_PIPELINE_IMAGE=

# ── 큐 모드 ──
DATA_PIPELINE_MINUTE_QUEUE_TRANSPORT=db

# ── data-pipeline 공통 ──
DATA_PIPELINE_DB__HOST=
DATA_PIPELINE_DB__PORT=
DATA_PIPELINE_DB__NAME=
DATA_PIPELINE_DB__USER=
DATA_PIPELINE_DB__PASSWORD=
DATA_PIPELINE_STORAGE__BACKEND=
DATA_PIPELINE_STORAGE__BUCKET=

# ── 태거 ──
# roberta 면 기동 때 레이크에서 모델 묶음을 받는다. llm 이면 LLM_API_KEY 가 필요하다
TAGGER_BACKEND=
TAGGER_THREADS=
RELEVANCE_FILTER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── 객체 저장소 (MinIO 등 S3 호환) ──
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=
