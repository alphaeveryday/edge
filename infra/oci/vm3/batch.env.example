# VM-3 의 /etc/edge/batch.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
# KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# 호스트 스크립트(lib/batch.sh)만 읽는다. 컨테이너에 넘기지 않는다 — 비밀값을 두지 않는다.

# 파이프라인 이미지(레지스트리 주소와 태그까지)
EDGE_PIPELINE_IMAGE=
# 스텝 컨테이너 메모리 상한. 뉴스 레인의 기본값과 같은 4g 를 적어 둔다 — 로컬 태거(tag-news)는 최대 2.0~2.2GB 를 썼고
# assemble-events 는 AWS 에서 4096MB 였다. 비밀값이 아니라 값을 적었다.
EDGE_STEP_MEMORY=4g
# 선택. 스텝 하나의 시간 상한(초, 기본 5400). 넘으면 컨테이너를 지우고 레인을 멈춘 뒤 알린다.
# 스텝 하나만 바꾸려면 EDGE_TIMEOUT_SEC_<레인>_<스텝> 을 쓴다(대문자, - 는 _ 로. 예: EDGE_TIMEOUT_SEC_NEWS_TAG).
EDGE_STEP_TIMEOUT_SEC=
# DAG 가 terraform 에서 받던 명령 인자(infra/terraform/modules/data-pipeline/variables.tf 의 tag_news_limit · assemble_window_days)
EDGE_TAG_NEWS_LIMIT=
EDGE_ASSEMBLE_WINDOW_DAYS=
