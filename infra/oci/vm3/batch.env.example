# VM-3 의 /etc/edge/batch.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
#
# 한 파일을 두 곳이 읽는다: docker --env-file(컨테이너 env)과 호스트 스크립트(lib/batch.sh · lib/edge_cron.py).
# 둘 다 KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# ── 호스트 스크립트가 읽는 값 ──
# 파이프라인 이미지(레지스트리 주소와 태그까지)
EDGE_PIPELINE_IMAGE=
# 선택. 스텝 컨테이너 메모리 상한(기본 2g). 로컬 태거는 Fargate 에서 최대 2.0~2.2GB 를 썼다
EDGE_STEP_MEMORY=
# DAG 가 terraform 에서 받던 명령 인자(infra/terraform/modules/data-pipeline/variables.tf 의 tag_news_limit · assemble_window_days)
EDGE_TAG_NEWS_LIMIT=
EDGE_ASSEMBLE_WINDOW_DAYS=
# 통보 메일 — 앱 메일 계정(호스트·계정은 infra/terraform/envs/dev/main.tf 의 SPRING_MAIL_HOST·SPRING_MAIL_USERNAME 과 같다)
EDGE_MAIL_HOST=
EDGE_MAIL_USER=
EDGE_DEV_APP_API_MAIL_PASSWORD=
EDGE_ALERT_TO=

# ── 컨테이너(data_pipeline.run)가 읽는 값 ──
# 레이크(VM-1 의 MinIO). 코드는 boto3 기본 클라이언트를 쓰므로 접속 주소·키를 boto3 표준 env 로 준다.
DATA_PIPELINE_STORAGE__BACKEND=
DATA_PIPELINE_STORAGE__BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_REGION_NAME=
# PostgreSQL(VM-1 의 사설 주소). TLS 를 안 쓰면 SSLMODE 를 맞춘다. 성공 행도 이 접속으로 쓴다.
DATA_PIPELINE_DB__HOST=
DATA_PIPELINE_DB__PORT=
DATA_PIPELINE_DB__NAME=
DATA_PIPELINE_DB__USER=
DATA_PIPELINE_DB__PASSWORD=
DATA_PIPELINE_DB__SSLMODE=
# 휴장일(쉼표로 구분한 YYYY-MM-DD). VM-1 과 같은 값
OPS_KR_HOLIDAYS=
# 태거·관련성 판정기(terraform 의 tagger_backend · relevance_filter 와 같은 값)
TAGGER_BACKEND=
RELEVANCE_FILTER=
# 선택. 추론 스레드 수. 비우면 보이는 CPU 수를 쓴다(Fargate 는 CPU 를 실제보다 많이 보여 줘서 넣던 값이다)
TAGGER_THREADS=
# LLM(이벤트 조립, 태거가 llm 일 때의 태깅)
LLM_API_KEY=
