# VM-3 의 /etc/edge/mail.env (소유자만 읽게 600). 이름만 적는다 — 값은 저장소에 넣지 않는다.
# KEY=VALUE 를 글자 그대로 읽는다. 값에 따옴표를 씌우거나 줄 끝에 주석을 붙이지 않는다.
# "선택"이라고 적은 줄은 쓰지 않으면 지운다(빈 값으로 두지 않는다).

# 통보 메일 계정 — lib/edge_cron.py 만 읽는다. 컨테이너에 넘기지 않는다.
# 앱 메일 계정이다(호스트·계정은 infra/terraform/envs/dev/main.tf 의 SPRING_MAIL_HOST·SPRING_MAIL_USERNAME 과 같다).
EDGE_MAIL_HOST=
EDGE_MAIL_USER=
EDGE_DEV_APP_API_MAIL_PASSWORD=
# 통보를 받을 주소
EDGE_ALERT_TO=
