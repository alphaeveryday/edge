# ── 검증 기간 호스트 관측기(ALPHA-1119, var.host_observer) ──
# 관측 대상(Airflow 태스크·ECS/SSM 에이전트·docker)이 죽거나 재시작해도 기록이 남도록 호스트 디스크에 append 한다.
# - samples.log: 5초마다 한 블록. T=시각, M=/proc/meminfo, S=메모리 압력(PSI), C=cgroup(모든 태스크·systemd 서비스 —
#   cur·peak·limit(memory.max)·anon·file·ev_*(memory.events: oom·oom_kill·max 등)·CPU),
#   P=RSS 상위 프로세스. cgroup 이 사라져도(컨테이너 재시작) 그 전까지의 값이 파일에 남는다.
# - kmsg.log: 커널 로그 전체(OOM killer 가 죽인 프로세스·cgroup 경로가 여기 남는다).
# - docker-events.log: 컨테이너 die(exitCode)·oom·start 이벤트.
# 수거는 SSM send-command(출력 → 검증 버킷 obs/). 상시 운영에서는 var.host_observer=false 로 설치하지 않는다.
mkdir -p /var/log/edge-obs
cat > /usr/local/bin/edge-obs-sample.sh <<'SH'
#!/bin/bash
OUT=/var/log/edge-obs/samples.log
cg_line() {
  d=$1
  cur=$(cat "$d/memory.current" 2>/dev/null) || return 0
  peak=$(cat "$d/memory.peak" 2>/dev/null || echo -)
  lim=$(cat "$d/memory.max" 2>/dev/null || echo -)
  sw=$(cat "$d/memory.swap.current" 2>/dev/null || echo -)
  st=$(awk '$1=="anon"||$1=="file"{printf "%s=%s ", $1, $2}' "$d/memory.stat" 2>/dev/null)
  ev=$(awk '{printf "ev_%s=%s ", $1, $2}' "$d/memory.events" 2>/dev/null)
  cpu=$(awk '$1=="usage_usec"||$1=="nr_throttled"||$1=="throttled_usec"||$1=="nr_periods"{printf "%s=%s ", $1, $2}' "$d/cpu.stat" 2>/dev/null)
  echo "C $d cur=$cur peak=$peak limit=$lim swap=$sw $st$ev$cpu"
}
while true; do
  {
    echo "T $(date +%s)"
    sed 's/^/M /' /proc/meminfo
    [ -r /proc/pressure/memory ] && sed 's/^/S memory /' /proc/pressure/memory
    [ -r /proc/pressure/cpu ] && sed 's/^/S cpu /' /proc/pressure/cpu
    for d in /sys/fs/cgroup /sys/fs/cgroup/*/ /sys/fs/cgroup/*/*/ /sys/fs/cgroup/*/*/*/; do
      [ -d "$d" ] && cg_line "$d"
    done
    ps -eo pid=,ppid=,rss=,comm=,args= --sort=-rss | head -40 | sed 's/^/P /'
  } >> "$OUT" 2>/dev/null
  sleep 5
done
SH
chmod +x /usr/local/bin/edge-obs-sample.sh
cat > /etc/systemd/system/edge-obs-sample.service <<'UNIT'
[Unit]
Description=edge airflow verification host sampler
[Service]
ExecStart=/usr/local/bin/edge-obs-sample.sh
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/edge-obs-kmsg.service <<'UNIT'
[Unit]
Description=edge airflow verification kernel log
[Service]
ExecStart=/bin/sh -c 'exec journalctl -k -f -o short-iso >> /var/log/edge-obs/kmsg.log'
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/edge-obs-docker.service <<'UNIT'
[Unit]
Description=edge airflow verification docker events
After=docker.service
Requires=docker.service
[Service]
ExecStart=/bin/sh -c 'exec docker events --format "{{json .}}" >> /var/log/edge-obs/docker-events.log'
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now --no-block edge-obs-sample.service edge-obs-kmsg.service edge-obs-docker.service
