#!/bin/bash
# 데모 온프렘 박스 부트스트랩 — docker + compose 플러그인까지만 (ADR-0033).
# 온프렘 스택(compose 파일·이미지)은 CD(SSM Run Command)가 얹는다.
# SSM 에이전트는 AL2023 에 기본 탑재 — 별도 설치 불필요.
set -euxo pipefail

# 2GB 스왑 — small(2GB·무스왑)에서 재배포 순간 메모리 스파이크를 흡수해 OOM-kill 을 막는다.
# 온프렘 JVM 4종에 heap 캡(mem_limit)이 없어 flyway one-shot + `--force-recreate` 이미지 churn 시
# 순간 초과가 나면 스왑이 받아낸다. dd(fallocate 아님) — 스왑 파일은 실블록이 필요하다.
# 가드는 파일 존재가 아니라 *스왑 활성 여부*로 본다 — 중간 실패로 남은 불완전 /swapfile 을
# 정상으로 오인하지 않도록 비활성이면 지우고 다시 만든다. fstab 등록은 중복 방지로 분리한다. 멱등.
if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
  rm -f /swapfile
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi
grep -qE '^/swapfile[[:space:]]' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab

dnf update -y
dnf install -y docker
systemctl enable --now docker

# docker compose v2 플러그인 (배포 산출물이 compose 라 필수)
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# CD 가 compose 파일을 놓을 자리
mkdir -p /opt/edge
