                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "commodity_return_20d_pct"
                  },
                  "value": {
                    "type": "number"
                  },
                  "observed_at": {
                    "oneOf": [
                      {
