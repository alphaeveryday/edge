{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alphaeveryday.dev/contracts/event-bundle.schema.json",
  "title": "Event Bundle",
  "description": "Tenant Sync API 가 온프렘 Sync Agent 로 전달하는 Event Bundle 와이어 계약. 필드 정의 SSOT 는 docs/contracts/event-bundle-schema.md, 이 JSON Schema 는 그 기계가독 실체다(ALPHA-497). tenant-sync-api openapi.yaml 이 이 파일을 $ref 한다.",
  "$ref": "#/$defs/EventBundle",
  "$defs": {
    "EventBundle": {
      "type": "object",
      "description": "테넌트별 전달 레코드를 cursor 순으로 묶은 전송 단위(봉투).",
      "additionalProperties": false,
      "required": ["bundle_id", "tenant_id", "generated_at", "cursor_from", "cursor_to", "entries"],
      "properties": {
        "bundle_id": {
          "type": "string",
          "format": "uuid",
          "description": "응답 인스턴스 식별용. 재-Pull 마다 새로 발번(멱등 키가 아니다 — dedup 은 cursor_from 기준)."
        },
        "tenant_id": {
          "type": "integer",
          "format": "int64",
          "description": "테넌트 identity (BIGINT)."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "번들 생성 시각(UTC ISO-8601)."
        },
        "cursor_from": {
          "type": "integer",
          "format": "int64",
          "description": "번들 첫 entry 의 cursor. received_bundle dedup 키."
        },
        "cursor_to": {
          "type": "integer",
          "format": "int64",
          "description": "번들 마지막 entry 의 cursor. 소비자의 다음 재개점."
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "description": "빈 번들은 만들지 않는다(신규 없음은 result 필드 생략 — ADR-0042).",
          "items": { "$ref": "#/$defs/BundleEntry" }
        }
      }
    },

    "BundleEntry": {
      "description": "전달 레코드 하나. delivery_type 으로 형상이 갈린다(oneOf). 서버 팩토리(BundleEntry.newResult·invalidation)가 내는 2형상과만 일치(CORRECTION 은 폐지 — ADR-0044).",
      "oneOf": [
        { "$ref": "#/$defs/NewEntry" },
        { "$ref": "#/$defs/InvalidationEntry" }
      ]
    },

    "NewEntry": {
      "type": "object",
      "description": "신규 설명(NEW) — 본체·실행·배열 포함, target/reason 없음.",
      "additionalProperties": false,
      "required": ["cursor", "delivery_type", "explanation_result", "explanation_run", "source_events", "evidences"],
      "properties": {
        "cursor": { "$ref": "#/$defs/EntryCursor" },
        "delivery_type": { "const": "NEW" },
        "explanation_result": { "$ref": "#/$defs/ExplanationResult" },
        "explanation_run": { "$ref": "#/$defs/ExplanationRun" },
        "source_events": { "$ref": "#/$defs/SourceEvents" },
        "evidences": { "$ref": "#/$defs/Evidences" }
      }
    },

    "InvalidationEntry": {
      "type": "object",
      "description": "무효화(INVALIDATION) — 대상·사유만. 결과·실행·배열은 모두 생략된다.",
      "additionalProperties": false,
      "required": ["cursor", "delivery_type", "target_explanation_result_id", "reason"],
      "properties": {
        "cursor": { "$ref": "#/$defs/EntryCursor" },
        "delivery_type": { "const": "INVALIDATION" },
        "target_explanation_result_id": { "type": "string", "description": "무효화 대상 원본 explanation_result_id." },
        "reason": { "type": "string", "description": "무효화 사유." }
      }
    },

    "EntryCursor": {
      "type": "integer",
      "format": "int64",
      "description": "번들 내 순서·도메인 반영 추적용. 재개점이 아니다(재개점은 봉투 cursor_to)."
    },

    "ExplanationResult": {
      "type": "object",
      "description": "고객 노출 후보 문구 — Cloud Event Store explanation_result 경계면. 모든 키가 항상 직렬화되며 일부 값은 null 일 수 있다.",
      "additionalProperties": false,
      "required": ["explanation_result_id", "etf_instrument_id", "etf_ticker", "etf_name", "trade_date", "explanation_as_of", "explanation_type", "summary", "confidence_level", "primary_thread_id"],
      "properties": {
        "explanation_result_id": { "type": "string", "description": "Cloud 발번 도메인 ID(TEXT). 멱등 upsert 키." },
        "etf_instrument_id": { "type": "string" },
        "etf_ticker": { "type": ["string", "null"], "description": "instrument LEFT JOIN 의 ticker — 매칭 없으면 null." },
        "etf_name": { "type": ["string", "null"], "description": "entity LEFT JOIN 의 display_name — 매칭 없으면 null." },
        "trade_date": { "type": "string", "format": "date" },
        "explanation_as_of": { "type": "string", "format": "date-time" },
        "explanation_type": {
          "type": "string",
          "description": "explanation_result.explanation_type CHECK 제약.",
          "enum": ["PRICE_ONLY", "EVENT_SUPPORTED", "MIXED", "UNCERTAIN"]
        },
        "summary": { "type": "string" },
        "confidence_level": {
          "type": ["string", "null"],
          "description": "미산정 시 null (DB CHECK — HIGH·MEDIUM·LOW 또는 NULL).",
          "enum": ["HIGH", "MEDIUM", "LOW", null]
        },
        "primary_thread_id": { "type": ["string", "null"], "description": "대표 스레드 참조 — 없으면 null." },
        "market_code": { "type": ["string", "null"], "description": "시장 코드(MIC) ← instrument.market_code. ALPHA-395 결정, producer 조인 구현(후속)까지는 미포함이라 optional — 구현 시 required 승격." },
        "observed_return": { "type": ["number", "null"], "description": "등락률 ← price_movement_trigger.observed_return. ALPHA-395 결정, producer 조인 구현(후속)까지는 미포함이라 optional." }
      }
    },

    "ExplanationRun": {
      "type": "object",
      "description": "결과를 낸 실행 + 사용한 릴리스 번들 버전 — explanation_run 경계면. 두 키 모두 항상 존재.",
      "additionalProperties": false,
      "required": ["explanation_run_id", "release_bundle_version"],
      "properties": {
        "explanation_run_id": { "type": "string" },
        "release_bundle_version": { "type": "string", "description": "explanation_run.bundle_version 값." }
      }
    },

    "SourceEvents": {
      "type": "array",
      "description": "설명이 근거로 삼은 소스 이벤트 목록. 근거(event_evidence)의 source_event_id 로 조립돼 실린다(ALPHA-718) — lineage 없는 런은 빈 배열. 컬럼 선별은 ALPHA-395 확정.",
      "minItems": 0,
      "items": { "$ref": "#/$defs/SourceEventItem" }
    },

    "SourceEventItem": {
      "type": "object",
      "description": "소스 이벤트 하나 (source_event 경계면 — ALPHA-395). 온프렘 소비자는 screening-worker 출처 수 정책 게이트(SINGLE_SOURCE·min_source_count — 고유 source_event_id 수), 이벤트 타임라인 UI 는 추가 소비 예정.",
      "additionalProperties": false,
      "required": ["source_event_id", "source_class", "event_type_code", "event_date"],
      "properties": {
        "source_event_id": { "type": "string" },
        "source_class": { "type": "string", "enum": ["NEWS", "DISCLOSURE"], "description": "source_event.source_class CHECK." },
        "event_type_code": { "type": "string", "description": "변동 요인·타임라인 라벨." },
        "event_date": { "type": ["string", "null"], "format": "date", "description": "타임라인 축 — nullable(source_event.event_date)." }
      }
    },

    "Evidences": {
      "type": "array",
      "description": "설명의 근거가 된 뉴스/공시 문서 목록. lineage 두 갈래(이벤트 근거·공시 정규화 사실) 조립으로 실린다(ALPHA-718) — 근거 없는 런은 빈 배열. 온프렘 소비자(publication-api ExplanationStore) 형상에 정렬(ALPHA-395).",
      "minItems": 0,
      "items": { "$ref": "#/$defs/EvidenceItem" }
    },

    "EvidenceItem": {
      "type": "object",
      "description": "근거 문서 하나 (document 경계면을 flat 화 — ALPHA-395). publication-api 가 파싱하는 {kind,title,source,published_at} 형상.",
      "additionalProperties": false,
      "required": ["kind", "title", "source", "published_at"],
      "properties": {
        "kind": { "type": "string", "enum": ["NEWS", "DISCLOSURE"], "description": "document.document_type." },
        "title": { "type": ["string", "null"], "description": "헤드라인 ← document.title (nullable)." },
        "source": { "type": "string", "description": "출처 ← document.source_code." },
        "published_at": { "type": ["string", "null"], "format": "date-time", "description": "← document.published_at (nullable)." }
      }
    }
  }
}
